# Files that run on the Linux server keep Linux line endings, whatever this PC's Git converts on checkout
*.sh                 text eol=lf
Caddyfile            text eol=lf
*.yml                text eol=lf
deploy-kit/**        text eol=lf
.env*.example        text eol=lf
# images and frames are never touched
*.webp *.avif *.png *.jpg *.ico *.pdf  binary
