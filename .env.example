# Monolith Sports: environment variables. Copy to .env.local (development) or set them in your host.
# Never commit real values. Every variable is read on the server only; none is sent to the browser.

# --- Site ---
# The public origin, used for canonical URLs, sitemaps, emails and links in PDFs.
SITE_URL=https://www.monolithsports.example

# --- Database ---
# Leave empty to use the embedded PGlite database in ./storage/pgdata (development and demos).
# Production: a PostgreSQL 14+ connection string (Supabase, Neon, RDS...). Use SSL.
DATABASE_URL=

# --- Security ---
# 32+ random bytes, base64. Signs the CSRF double-submit token and the consent cookie.
APP_SECRET=
# First administrator, created on the first start when no administrator exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email (Resend) ---
# Without RESEND_API_KEY every email is written to the outbox table (Admin > Outbox) instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Monolith Sports <quotes@monolithsports.example>
# Where new-inquiry notifications go.
ADMIN_NOTIFY_EMAIL=

# --- Spam protection (Cloudflare Turnstile, optional) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional; loads only after the visitor accepts analytics cookies) ---
GA4_MEASUREMENT_ID=
# Google Search Console HTML-tag verification code.
GOOGLE_SITE_VERIFICATION=

# --- File storage ---
# Local folder for uploads (inquiry attachments, logos, product media). Kept outside /public.
UPLOAD_DIR=./storage/uploads

# --- Image and film generation (Kie AI, used only by scripts/generate-media.mjs at build time) ---
KIE_API_KEY=
