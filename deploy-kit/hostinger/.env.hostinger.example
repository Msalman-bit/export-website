# Monolith Sports on a Hostinger VPS (docker compose). Copy this file to .env in the same folder and fill it in:
#     cp .env.hostinger.example .env && nano .env && chmod 600 .env
# Never share .env or put it anywhere public. DATABASE_URL and UPLOAD_DIR are set by docker-compose.yml: leave them out.

# --- The address ---
# The main name visitors use, and the other one, which redirects to it (one with www, one without).
SITE_HOST=www.your-domain.com
ALT_HOST=your-domain.com
# The same main address with https://, for links in emails, PDFs, the sitemap and search results.
SITE_URL=https://www.your-domain.com
# Let's Encrypt writes here if a certificate ever needs attention.
ACME_EMAIL=you@your-domain.com

# --- Secrets: generate each on the server, never reuse one from somewhere else ---
# openssl rand -base64 48
APP_SECRET=
# openssl rand -hex 24   (letters and digits only: it goes inside the database address)
POSTGRES_PASSWORD=

# --- The first administrator: created on the first start; delete both lines after you have signed in ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email (Resend): without a key, every email is only kept in Admin > Email outbox ---
RESEND_API_KEY=
EMAIL_FROM=Monolith Sports <quotes@your-domain.com>
# Where new inquiries are announced.
ADMIN_NOTIFY_EMAIL=

# --- Optional ---
# Cloudflare Turnstile on the public forms
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Google Analytics 4 (loads only for visitors who accept analytics cookies); or set it in Admin > Settings
GA4_MEASUREMENT_ID=
# Google Search Console, HTML-tag method
GOOGLE_SITE_VERIFICATION=
