{
  "name": "monolith-sports",
  "version": "0.1.0",
  "private": true,
  "description": "Monolith Sports: B2B sports equipment catalogue, customisation studio, quotation system, customer portal and administration.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/1-journey.test.mjs tests/e2e/2-admin-flow.test.mjs tests/e2e/3-portal-flow.test.mjs tests/e2e/4-quotation-delete.test.mjs tests/e2e/5-inquiry-delete.test.mjs tests/e2e/6-categories.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "map:build": "node scripts/build-map.mjs",
    "audit:deps": "npm audit --omit=dev",
    "package": "node scripts/package-deploy.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/topojson-client": "3.1.5",
    "d3-geo": "3.1.2",
    "drizzle-kit": "0.31.11",
    "topojson-client": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "world-atlas": "2.0.2"
  }
}
